# 后端配置样例：复制为 .env 后按需修改
# 应用名称
APP_NAME=鲜衡云 API
# 数据库连接串：SQLite 起步，切换 PostgreSQL 时改为
# postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=sqlite:///./pos.db
# 登录令牌签名密钥（必填，至少 32 位随机字符串；留空或过短服务将拒绝启动）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：切勿把真实密钥提交到仓库；轮换密钥后历史令牌全部失效，凭密码重新登录即可
AUTH_SECRET=
# 启动时是否自动建表（生产必须为 false，schema 统一由 Alembic 迁移管理）
AUTO_CREATE_TABLES=false
# 启动时是否自动写入演示账号（生产必须为 false，避免自动创建弱口令账号）
AUTO_SEED_USERS=false
# 种子账号初始密码（仅 AUTO_SEED_USERS=true 时生效，至少 8 位；留空则随机生成并打印启动日志）
SEED_USER_PASSWORD=
# 雪花 ID 机器位 / 数据中心位（各 0-31）
# 服务启动时优先在系统临时目录用跨进程文件锁自动抢占 0-31 中未占用的 worker 编号，
# 进程存活期间持锁，因此多实例部署通常无需手工配置；仅当 32 个编号全部被占用时，
# 才回退到下面显式配置的值并打印警告。
# 注意：若依赖手工回退，多实例部署时 SNOWFLAKE_WORKER_ID / SNOWFLAKE_DATACENTER_ID
#       必须各不相同，否则会生成重复雪花 ID；建议保持自动分配（不设置这两个变量）。
# SNOWFLAKE_WORKER_ID=1
# SNOWFLAKE_DATACENTER_ID=1

# ---- B3 / Q24 会员流水历史门店归属分界 ----
# 取 3f9a1c7b2d55 迁移执行 / 上线时间，ISO 8601（如 2026-11-08T00:00:00Z，按 UTC 比较）。
# 留空或未配置为安全默认：全部历史流水标注「历史数据门店归属不可信」。
# 仅影响报表 / 流水标注，不回填历史数据、不新增列、不新增 Alembic 迁移。
MEMBER_TX_STORE_RELIABLE_SINCE=

# ---- B3 / R20 临时资金管控（Q06 完成后由 B4 统一解除，非永久业务逻辑）----
# 数值待产品确认：确认后只改本配置，不改代码、不发版；前端文案不写死具体数字。
# 在线储值支付开关：默认 false（临时下线）。
# ⚠️ 警告：Q06 结算接口完成前严禁设为 true，否则「不扣先返」套利面重新敞开。
ONLINE_STORED_VALUE_PAYMENT_ENABLED=false
# 离线订单补传金额上限（元）
OFFLINE_ORDER_MAX_AMOUNT=200
# 离线订单发生时间距今时限（小时）
OFFLINE_ORDER_MAX_AGE_HOURS=2
